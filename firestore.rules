rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isFarmMember(farmId) {
      return isSignedIn() && (
        farmId == 'odivon-farm-default' ||
        exists(/databases/$(database)/documents/farms/$(farmId)/members/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/farms/$(farmId)) &&
         get(/databases/$(database)/documents/farms/$(farmId)).data.ownerUid == request.auth.uid)
      );
    }

    function getFarmMember(farmId) {
      return get(/databases/$(database)/documents/farms/$(farmId)/members/$(request.auth.uid)).data;
    }

    function isFarmAdmin(farmId) {
      return isSignedIn() && (
        farmId == 'odivon-farm-default' ||
        (exists(/databases/$(database)/documents/farms/$(farmId)) &&
         get(/databases/$(database)/documents/farms/$(farmId)).data.ownerUid == request.auth.uid) ||
        (exists(/databases/$(database)/documents/farms/$(farmId)/members/$(request.auth.uid)) &&
         getFarmMember(farmId).role == 'admin')
      );
    }

    function canWriteFarmData(farmId) {
      return isFarmMember(farmId) && (
        isFarmAdmin(farmId) ||
        (exists(/databases/$(database)/documents/farms/$(farmId)/members/$(request.auth.uid)) &&
         getFarmMember(farmId).role != 'okuyucu')
      );
    }

    // Kullanıcı profilleri
    match /users/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == uid;

      // Kullanıcı oturum ve giriş logları
      match /loginLogs/{logId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
    }

    // Çiftlik ana dokümanı ve tüm alt koleksiyonları
    match /farms/{farmId} {
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow read: if isFarmMember(farmId);
      allow update, delete: if isFarmAdmin(farmId);

      // Çiftlik aktivite ve denetim günlüğü
      match /activityLog/{logId} {
        allow read: if isFarmMember(farmId);
        allow create, write: if isFarmMember(farmId);
      }

      // Çiftlik üyeleri
      match /members/{memberId} {
        allow read: if isFarmMember(farmId);
        allow write: if isFarmAdmin(farmId) || (isSignedIn() && request.auth.uid == memberId);
      }

      // Abonelik bilgisi
      match /subscription/{subDoc} {
        allow read: if isFarmMember(farmId);
        allow write: if isFarmAdmin(farmId);
      }

      // Muhasebe hareketleri (okuyucu ve saha hariç)
      match /accounting-tx/{txId} {
        allow read: if isFarmMember(farmId);
        allow write: if isFarmMember(farmId) && (
          isFarmAdmin(farmId) ||
          getFarmMember(farmId).role in ['yonetici', 'muhasebe']
        );
      }

      // Diğer tüm operasyonel koleksiyonlar (animals, treatments, matings, weights, tasks, counts, yields, stock vb.)
      match /{collectionPath=**} {
        allow read: if isFarmMember(farmId);
        allow write: if canWriteFarmData(farmId);
      }
    }

    // E-posta kuyruğu (Cloud Functions SMTP tetikleyicisi)
    match /mail/{mailId} {
      allow create: if isSignedIn();
      allow read, update: if isSignedIn();
    }
  }
}
